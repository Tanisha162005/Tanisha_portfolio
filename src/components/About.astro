---
---
<section id="about" class="mb-32 scroll-mt-24 pt-12" aria-label="About Me">
  <div class="gsap-reveal flex items-center gap-6 mb-16">
    <h3 class="text-4xl md:text-5xl font-display font-bold text-text">About Me</h3>
    <div class="h-px bg-glass-border flex-grow"></div>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-20 items-center">
    <div class="md:col-span-7 text-lg md:text-xl leading-[1.8] text-text-muted space-y-8">
      <p class="gsap-about-text opacity-0">
        I'm a B.Tech AI & ML student at R.C. Patel Institute of Technology <span class="text-text font-bold">(GPA 9.20)</span>, currently working as an AI Research Intern at Tagowls and running my own freelance AI/web development practice.
      </p>
      <p class="gsap-about-text opacity-0">
        My work spans NLP applications, RAG-based systems, and agentic AI workflows &mdash; I care about building things that are <span class="text-accent-pop font-semibold">technically sound and genuinely useful</span>, not just demo-able. I thrive on solving complex problems with elegant code.
      </p>
      <p class="gsap-about-text opacity-0">
        When I'm not coding, I'm usually exploring new tech trends, reading about artificial general intelligence, or thinking about how to optimize the next big project.
      </p>
    </div>
    
    <div class="md:col-span-5 flex justify-center gsap-about-image opacity-0">
      <div class="relative group w-72 h-72 md:w-full md:h-auto max-w-sm">
        <div class="absolute -inset-4 bg-gradient-to-r from-[#7C3AED] to-[#22D3EE] rounded-2xl opacity-10 group-hover:opacity-30 blur-xl transition duration-700"></div>
        <div class="relative aspect-square rounded-2xl overflow-hidden border border-glass-border glass-panel">
          <img 
            src="/avatar-placeholder.jpg" 
            alt="Tanisha Badgujar" 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 filter grayscale hover:grayscale-0"
          />
          <div class="absolute inset-0 bg-[#22D3EE]/10 mix-blend-overlay group-hover:bg-transparent transition-colors duration-700"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // Text stagger
    const textElements = document.querySelectorAll('.gsap-about-text');
    if (textElements.length > 0) {
      gsap.fromTo(textElements, 
        { y: 30, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.15,
          ease: "power3.out",
          scrollTrigger: {
            trigger: "#about",
            start: "top 80%",
            toggleActions: "play none none reverse"
          }
        }
      );
    }

    // Image reveal
    const imageElement = document.querySelector('.gsap-about-image');
    if (imageElement) {
      gsap.fromTo(imageElement,
        { scale: 0.95, opacity: 0, rotation: -2 },
        {
          scale: 1,
          opacity: 1,
          rotation: 0,
          duration: 1.2,
          ease: "back.out(1.2)",
          scrollTrigger: {
            trigger: "#about",
            start: "top 75%",
            toggleActions: "play none none reverse"
          }
        }
      );
    }
  });
</script>
