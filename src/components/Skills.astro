---
const skillGroups = [
  { category: "Programming", skills: ["Python", "SQL"] },
  { category: "AI/ML", skills: ["Machine Learning", "NLP", "Data Preprocessing", "Model Evaluation"] },
  { category: "Frameworks", skills: ["Flask", "LangChain", "Pandas", "NumPy", "Matplotlib", "Seaborn"] },
  { category: "GenAI & Tools", skills: ["OpenAI APIs", "MCPs", "n8n", "RAG", "Vector DBs", "Docker", "AWS", "GitHub"] }
];
---
<section class="mb-32 scroll-mt-24" aria-label="Skills">
  <div class="gsap-reveal flex items-center gap-6 mb-12">
    <h4 class="text-2xl font-display font-bold text-text">Core Skills</h4>
    <div class="h-px bg-glass-border flex-grow"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12">
    {skillGroups.map((group, i) => (
      <div class="gsap-skill-group">
        <h4 class="text-sm font-bold uppercase tracking-widest text-text mb-5 border-l-2 border-accent-pop pl-3">{group.category}</h4>
        <ul class="flex flex-wrap gap-3" aria-label={`Skills in ${group.category}`}>
          {group.skills.map(skill => (
            <li class="flex items-center rounded-lg bg-surface-hi px-4 py-2 text-sm font-medium text-text-muted border border-glass-border transition-all duration-300 hover:border-[#22D3EE]/50 hover:text-text hover:shadow-[0_0_15px_rgba(34,211,238,0.15)] cursor-default hover:-translate-y-0.5">
              {skill}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const skillGroups = document.querySelectorAll('.gsap-skill-group');
    
    if (skillGroups.length > 0) {
      gsap.fromTo(skillGroups,
        { y: 30, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.8,
          stagger: 0.15,
          ease: "power3.out",
          scrollTrigger: {
            trigger: skillGroups[0],
            start: "top 85%",
            toggleActions: "play none none reverse"
          }
        }
      );
    }
  });
</script>
