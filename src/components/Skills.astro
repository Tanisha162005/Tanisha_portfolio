---
const skillGroups = [
  { category: "Programming", skills: ["Python", "SQL"] },
  { category: "AI/ML", skills: ["Machine Learning", "NLP", "Data Preprocessing", "Model Evaluation"] },
  { category: "Frameworks", skills: ["Flask", "LangChain", "Pandas", "NumPy", "Matplotlib", "Seaborn"] },
  { category: "GenAI & tools", skills: ["OpenAI APIs", "MCPs", "n8n", "RAG", "Vector DBs", "Docker", "AWS", "GitHub"] }
];
---
<section class="mb-32 scroll-mt-24" data-section aria-label="Skills">
  <div class="section-content">
    <h2 class="mb-10">Core skills</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
      {skillGroups.map((group) => (
        <div>
          <p class="mb-4 text-sm" style="color: var(--color-text-muted);">{group.category}</p>
          <ul class="flex flex-wrap gap-2" aria-label={`Skills in ${group.category}`}>
            {group.skills.map(skill => (
              <li class="pill">{skill}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
