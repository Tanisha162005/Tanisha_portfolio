---
const achievements = [
  "1st Place — GDG On Campus Hackathon, DY Patil Kolhapur",
  "Core Member, E-Cell · Technical Member, Data Polaris",
  "Guest speaker — AI fundamentals & future technologies",
  "5+ hackathons, 1 bootcamp, multiple AI events attended"
];

const stats = [
  { value: 9.2, suffix: " GPA", label: "Academic excellence", isFloat: true },
  { value: 5, suffix: "+", label: "Hackathons", isFloat: false },
  { value: 1, suffix: "st", label: "Place at GDG hackathon", isFloat: false },
];
---
<section id="achievements" class="mb-32 scroll-mt-24 pt-12" data-section aria-label="Achievements">
  <div class="section-content">
    <h2 class="mb-12">Achievements</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-14">
      {stats.map(stat => (
        <div class="card p-7 text-center">
          <div class="text-3xl md:text-4xl mb-2" style="font-family: var(--font-display); font-weight: 500; color: var(--color-accent);">
            <span class="gsap-counter" data-target={stat.value} data-float={stat.isFloat ? "true" : "false"}>0</span>{stat.suffix}
          </div>
          <p class="text-sm mt-3" style="color: var(--color-text-muted);">{stat.label}</p>
        </div>
      ))}
    </div>

    <ul class="space-y-4">
      {achievements.map((item) => (
        <li class="achievement-item flex items-start p-5 rounded-lg" style="background: var(--color-surface); border: 1px solid var(--color-border); transition: border-color 150ms ease;">
          <svg class="h-5 w-5 shrink-0 mr-3.5 mt-0.5" style="color: var(--color-accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span style="color: var(--color-text-muted); line-height: 1.6;">{item}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .achievement-item:hover {
    border-color: var(--color-accent) !important;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // Number counters — kept as interesting content-driven animation
    const counters = document.querySelectorAll('.gsap-counter');
    counters.forEach(counter => {
      const target = parseFloat(counter.getAttribute('data-target') || '0');
      const isFloat = counter.getAttribute('data-float') === 'true';
      
      ScrollTrigger.create({
        trigger: counter,
        start: 'top 85%',
        onEnter: () => {
          gsap.to(counter, {
            innerHTML: target,
            duration: 2,
            ease: 'power2.out',
            snap: { innerHTML: isFloat ? 0.1 : 1 },
            onUpdate: function() {
              if (isFloat) {
                counter.innerHTML = Number(this.targets()[0].innerHTML).toFixed(1);
              }
            }
          });
        },
        once: true
      });
    });
  });
</script>
