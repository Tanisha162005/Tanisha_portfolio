---
---
<div class="absolute inset-0 -z-10 overflow-hidden pointer-events-none opacity-20 lg:opacity-40" aria-hidden="true">
  <svg class="w-full h-full text-accent" viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
    <g class="node-lines stroke-current" stroke-width="1" stroke-linecap="round" fill="none">
      <!-- Lines connecting nodes -->
      <path class="line line-1" d="M100,150 L250,80" />
      <path class="line line-2" d="M250,80 L400,200" />
      <path class="line line-3" d="M400,200 L550,120" />
      <path class="line line-4" d="M400,200 L300,350" />
      <path class="line line-5" d="M300,350 L150,300" />
      <path class="line line-6" d="M150,300 L100,150" />
      <path class="line line-7" d="M550,120 L700,250" />
      <path class="line line-8" d="M700,250 L600,450" />
      <path class="line line-9" d="M600,450 L400,500" />
      <path class="line line-10" d="M400,500 L300,350" />
      <path class="line line-11" d="M250,80 L150,300" />
      <path class="line line-12" d="M550,120 L400,500" />
    </g>
    
    <g class="nodes fill-current">
      <circle class="node node-1" cx="100" cy="150" r="4" />
      <circle class="node node-2" cx="250" cy="80" r="5" />
      <circle class="node node-3" cx="400" cy="200" r="6" />
      <circle class="node node-4" cx="550" cy="120" r="4" />
      <circle class="node node-5" cx="300" cy="350" r="5" />
      <circle class="node node-6" cx="150" cy="300" r="4" />
      <circle class="node node-7" cx="700" cy="250" r="5" />
      <circle class="node node-8" cx="600" cy="450" r="6" />
      <circle class="node node-9" cx="400" cy="500" r="4" />
    </g>
  </svg>
</div>

<style>
  /* Base styles for no-js or reduced motion */
  .line {
    opacity: 0.3;
  }
  .node {
    opacity: 0.7;
  }

  /* Animations are applied via JS to ensure they only run once and respect preferences */
  @media (prefers-reduced-motion: no-preference) {
    .js-enabled .line {
      stroke-dasharray: 1000;
      stroke-dashoffset: 1000;
      opacity: 0.3;
    }
    
    .js-enabled .node {
      opacity: 0;
      transform: scale(0);
      transform-origin: center;
    }

    /* Node entry animation */
    @keyframes nodeEnter {
      0% { opacity: 0; transform: scale(0); }
      100% { opacity: 0.7; transform: scale(1); }
    }

    /* Line drawing animation */
    @keyframes lineDraw {
      to { stroke-dashoffset: 0; }
    }

    /* Infinite drifting */
    @keyframes drift {
      0% { transform: translate(0, 0); }
      33% { transform: translate(3px, -5px); }
      66% { transform: translate(-4px, 2px); }
      100% { transform: translate(0, 0); }
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (prefersReducedMotion) return;

    const container = document.querySelector('.js-enabled') || document.body;
    container.classList.add('js-enabled');

    const nodes = document.querySelectorAll('.node');
    const lines = document.querySelectorAll('.line');

    // Staggered node entrance
    nodes.forEach((node, index) => {
      // @ts-ignore
      node.style.animation = `nodeEnter 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) ${index * 0.08}s forwards`;
      
      // Start drift after entrance
      setTimeout(() => {
        // @ts-ignore
        node.style.animation = `drift ${8 + Math.random() * 4}s ease-in-out infinite alternate`;
      }, (index * 80) + 600);
    });

    // Line drawing after nodes
    lines.forEach((line, index) => {
      const delay = (nodes.length * 0.08) + (index * 0.05);
      // @ts-ignore
      line.style.animation = `lineDraw 1.2s ease-out ${delay}s forwards`;
    });
  });
</script>
