---
import experiences from '../content/experience.json';
---
<section id="experience" class="mb-16 scroll-mt-24 lg:mb-24" aria-label="Work Experience">
  <h3 class="text-[22px] font-display font-medium text-text mb-6">Experience</h3>
  
  <ol class="relative border-l border-accent-dim ml-3 space-y-12">
    {experiences.map(job => (
      <li class="ml-6">
        <span class="absolute flex items-center justify-center w-3 h-3 bg-accent rounded-full -left-1.5 ring-4 ring-base"></span>
        <h4 class="text-text font-medium text-[17px] leading-tight mb-1">{job.role}</h4>
        <div class="text-text-muted text-sm mb-4 font-medium tracking-wide">
          <span>{job.company}</span>
          <span class="mx-2">&middot;</span>
          <span>{job.period}</span>
        </div>
        <p class="text-text-muted text-[17px] leading-[1.6]">
          {job.description}
        </p>
      </li>
    ))}
  </ol>
</section>
