---
import experiences from '../content/experience.json';
---
<section id="experience" class="mb-32 scroll-mt-24 pt-12" aria-label="Work Experience">
  <div class="gsap-reveal flex items-center gap-6 mb-16">
    <h3 class="text-4xl md:text-5xl font-display font-bold text-text">Experience</h3>
    <div class="h-px bg-glass-border flex-grow"></div>
  </div>
  
  <ol class="relative border-l border-glass-border ml-4 space-y-16">
    {experiences.map(job => (
      <li class="gsap-experience-item ml-8 relative group">
        <span class="absolute flex items-center justify-center w-3 h-3 bg-accent rounded-full -left-[38px] top-2 ring-[6px] ring-base group-hover:bg-accent-pop group-hover:shadow-[0_0_15px_rgba(245,158,11,0.6)] transition-all duration-300"></span>
        <h4 class="text-2xl font-display font-bold text-text mb-2 group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-[#7C3AED] group-hover:to-[#22D3EE] transition-all duration-300 inline-block">{job.role}</h4>
        <div class="text-text-muted text-sm md:text-base mb-6 font-medium tracking-wide flex items-center flex-wrap gap-3">
          <span class="text-accent-pop font-bold">{job.company}</span>
          <span class="opacity-50">&bull;</span>
          <span class="bg-surface-hi px-3 py-1 rounded-md text-xs border border-glass-border font-mono">{job.period}</span>
        </div>
        <p class="text-text-muted text-base md:text-lg leading-[1.7] max-w-3xl">
          {job.description}
        </p>
      </li>
    ))}
  </ol>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.gsap-experience-item');
    
    items.forEach((item) => {
      gsap.fromTo(item, 
        { x: -40, autoAlpha: 0 },
        {
          x: 0,
          autoAlpha: 1,
          duration: 0.9,
          ease: "power3.out",
          scrollTrigger: {
            trigger: item,
            start: "top 85%",
            toggleActions: "play none none reverse"
          }
        }
      );
    });
  });
</script>
