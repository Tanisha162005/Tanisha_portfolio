---
import experiences from '../content/experience.json';
---
<section id="experience" class="mb-32 scroll-mt-24 pt-12" data-section aria-label="Work experience">
  <div class="section-content">
    <h2 class="mb-12">Experience</h2>
    
    <ol class="relative ml-3 space-y-14" style="border-left: 1px solid var(--color-border);">
      {experiences.map(job => (
        <li class="ml-8 relative">
          <span class="absolute flex items-center justify-center w-[7px] h-[7px] rounded-full -left-[35px] top-2.5" style="background: var(--color-accent);"></span>
          <h3 style="color: var(--color-text);">{job.role}</h3>
          <div class="mt-1.5 mb-4 text-sm" style="color: var(--color-text-muted);">
            <span style="color: var(--color-accent);">{job.company}</span>, {job.period}
          </div>
          <p class="max-w-3xl">{job.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
