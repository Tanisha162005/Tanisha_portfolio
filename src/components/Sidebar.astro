</header>

<script>
  // Mobile Menu Toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const path = document.getElementById('menu-icon-path');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu && path) {
    let isOpen = false;
    const toggleMenu = () => {
      isOpen = !isOpen;
      if (isOpen) {
        menu.classList.remove('hidden');
        path.setAttribute('d', 'M6 18L18 6M6 6l12 12');
      } else {
        menu.classList.add('hidden');
        path.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
      }
    };
    
    btn.addEventListener('click', toggleMenu);
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        if(window.innerWidth < 1024 && isOpen) {
          toggleMenu();
        }
      });
    });
  }

  // Intersection Observer for highlighting active nav link
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          document.querySelectorAll('.active-nav-link').forEach((link) => {
            link.classList.remove('active');
            const indicator = link.querySelector('.nav-indicator');
            const text = link.querySelector('.nav-text');
            if (indicator) {
              indicator.classList.remove('w-16', 'bg-text');
              indicator.classList.add('w-8', 'bg-text-muted');
            }
            if (text) {
              text.classList.remove('text-text');
              text.classList.add('text-text-muted');
            }
          });

          const activeLink = document.querySelector(`.active-nav-link[href="#${entry.target.id}"]`);
          if (activeLink) {
            activeLink.classList.add('active');
            const indicator = activeLink.querySelector('.nav-indicator');
            const text = activeLink.querySelector('.nav-text');
            if (indicator) {
              indicator.classList.remove('w-8', 'bg-text-muted');
              indicator.classList.add('w-16', 'bg-text');
            }
            if (text) {
              text.classList.remove('text-text-muted');
              text.classList.add('text-text');
            }
          }
        }
      });
    },
    { rootMargin: '-20% 0px -80% 0px' }
  );

  document.querySelectorAll('section[id]').forEach((section) => {
    observer.observe(section);
  });
</script>
