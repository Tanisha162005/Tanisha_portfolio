---
const navItems = [
  { name: 'About', href: '#about' },
  { name: 'Experience', href: '#experience' },
  { name: 'Projects', href: '#projects' },
  { name: 'Achievements', href: '#achievements' },
  { name: 'Resume', href: '/resume.pdf', external: true },
];
---

<header class="sticky top-0 z-50 w-full glass-panel !rounded-none !border-x-0 !border-t-0 px-6 py-4 md:px-12 transition-all duration-300">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand / Logo -->
    <div class="flex items-center gap-4">
      <a href="/" class="group flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-accent/10 border border-accent/30 flex items-center justify-center text-accent font-display font-bold text-xl group-hover:bg-accent group-hover:text-base transition-colors duration-300">
          T
        </div>
        <div>
          <h1 class="text-xl font-display font-medium text-text tracking-tight group-hover:text-accent transition-colors duration-300">
            Tanisha Badgujar
          </h1>
          <p class="hidden md:block text-xs text-text-muted mt-0.5">AI & ML Engineer</p>
        </div>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button id="mobile-menu-btn" class="lg:hidden text-text hover:text-accent focus:outline-none p-2 -mr-2 transition-colors" aria-label="Toggle menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Desktop Navigation & Socials -->
    <div class="hidden lg:flex items-center gap-8">
      <nav aria-label="Main Navigation">
        <ul class="flex items-center gap-6">
          {navItems.map(item => (
            <li>
              <a class="nav-link text-sm font-medium text-text-muted hover:text-accent transition-colors duration-300 relative py-2" href={item.href} target={item.external ? "_blank" : undefined}>
                {item.name}
                <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-accent transition-all duration-300 group-hover:w-full"></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      
      <div class="h-6 w-px bg-glass-border"></div>

      <!-- Socials -->
      <ul class="flex items-center gap-4" aria-label="Social media">
        <li>
          <a href="mailto:tanisha.c.badgujar@gmail.com" class="text-text-muted hover:text-accent hover-pulse-glow transition-all rounded-full p-1 block" target="_blank" rel="noreferrer" aria-label="Email">
