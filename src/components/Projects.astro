---
import ProjectCard from './ProjectCard.astro';
import projectsData from '../content/projects.json';
import freelanceData from '../content/freelance.json';
---
<section id="projects" class="mb-32 scroll-mt-24 pt-12" aria-label="Selected Projects">
  <div class="gsap-reveal flex items-center gap-6 mb-16">
    <h3 class="text-4xl md:text-5xl font-display font-bold text-text">Selected Projects</h3>
    <div class="h-px bg-glass-border flex-grow"></div>
  </div>
  
  <div class="space-y-24">
    <!-- Academic & Personal -->
    <div>
      <h4 class="gsap-reveal text-2xl font-display font-medium text-text-muted mb-10">Academic & Personal Work</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {projectsData.map((project, index) => {
          // Asymmetric layout: every 3rd item is large (takes 2 columns on desktop)
          const isLarge = index % 3 === 0;
          return (
            <div class={`gsap-project-card ${isLarge ? 'md:col-span-2' : ''}`}>
              <ProjectCard 
                title={project.title}
                description={project.description}
                tags={project.tags}
                link={project.link}
                large={isLarge}
              />
            </div>
          );
        })}
      </div>
    </div>

    <!-- Freelance -->
    <div>
      <h4 class="gsap-reveal text-2xl font-display font-medium text-text-muted mb-10 flex items-center">
        Freelance Work
        <span class="ml-4 px-3 py-1 rounded bg-accent-pop/10 text-accent-pop text-xs font-bold border border-accent-pop/20 tracking-wider">NEW</span>
      </h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {freelanceData.map((project, index) => {
          const isLarge = index % 3 === 1; // offset the large items for variety
          return (
            <div class={`gsap-project-card ${isLarge ? 'md:col-span-2' : ''}`}>
              <ProjectCard 
                title={project.title}
                description={project.description}
                tags={project.tags}
                link={project.link}
                large={isLarge}
              />
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    // Reveal project cards on scroll
    const cards = document.querySelectorAll('.gsap-project-card');
    
    cards.forEach((card, i) => {
      gsap.fromTo(card,
        { y: 60, autoAlpha: 0 },
        {
          y: 0,
          autoAlpha: 1,
          duration: 0.8,
          ease: "power3.out",
          scrollTrigger: {
            trigger: card,
            start: "top 85%",
            toggleActions: "play none none reverse"
          }
        }
      );
    });

    // Hover Parallax & Tag animation
    const projectLinks = document.querySelectorAll('.project-card');
    
    projectLinks.forEach(link => {
      const content = link.querySelector('.project-content');
      const tags = link.querySelectorAll('.project-tags li');
      
      link.addEventListener('mouseenter', () => {
        gsap.to(link, { y: -6, duration: 0.4, ease: "power2.out" });
        if (content) {
          gsap.to(content, { y: -2, duration: 0.4, ease: "power2.out" });
        }
        if (tags.length) {
          gsap.fromTo(tags, 
            { y: 10, opacity: 0 },
            { y: 0, opacity: 1, duration: 0.3, stagger: 0.05, ease: "back.out(1.5)", overwrite: true }
          );
        }
      });
      
      link.addEventListener('mouseleave', () => {
        gsap.to(link, { y: 0, duration: 0.4, ease: "power2.out" });
        if (content) {
          gsap.to(content, { y: 0, duration: 0.4, ease: "power2.out" });
        }
      });
    });
  });
</script>
