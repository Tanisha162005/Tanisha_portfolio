---
import ProjectCard from './ProjectCard.astro';
import projectsData from '../content/projects.json';
import freelanceData from '../content/freelance.json';
---
<section id="projects" class="mb-32 scroll-mt-24 pt-12" data-section aria-label="Selected projects">
  <div class="section-content">
    <h2 class="mb-14">Selected projects</h2>
    
    <div class="space-y-20">
      <!-- Academic & personal -->
      <div>
        <p class="mb-8 text-lg" style="color: var(--color-text-muted);">Academic & personal work</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {projectsData.map((project, index) => {
            const isLarge = index % 3 === 0;
            return (
              <div class={isLarge ? 'md:col-span-2' : ''}>
                <ProjectCard 
                  title={project.title}
                  description={project.description}
                  tags={project.tags}
                  link={project.link}
                  large={isLarge}
                />
              </div>
            );
          })}
        </div>
      </div>

      <!-- Freelance -->
      <div>
        <p class="mb-8 text-lg" style="color: var(--color-text-muted);">Freelance work</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {freelanceData.map((project, index) => {
            const isLarge = index % 3 === 1;
            return (
              <div class={isLarge ? 'md:col-span-2' : ''}>
                <ProjectCard 
                  title={project.title}
                  description={project.description}
                  tags={project.tags}
                  link={project.link}
                  large={isLarge}
                />
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>
