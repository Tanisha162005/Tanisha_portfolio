---
import ProjectCard from './ProjectCard.astro';
import projectsData from '../content/projects.json';
import freelanceData from '../content/freelance.json';
---
<section id="projects" class="mb-24 scroll-mt-24 pt-12" aria-label="Selected Projects">
  <div class="flex items-center gap-4 mb-10">
    <h3 class="text-3xl font-display font-bold text-text">Selected Projects</h3>
    <div class="h-px bg-glass-border flex-grow"></div>
  </div>
  
  <div class="space-y-12">
    <div>
      <h4 class="text-xl font-display font-medium text-text-muted mb-6">Academic & Personal Work</h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 animate-on-scroll animate-fade-up">
        {projectsData.map((project, index) => (
          <div style={`animation-delay: ${index * 100}ms`} class="animate-fade-up animate-on-scroll">
            <ProjectCard 
              title={project.title}
              description={project.description}
              tags={project.tags}
              link={project.link}
            />
          </div>
        ))}
      </div>
    </div>

    <div>
      <h4 class="text-xl font-display font-medium text-text-muted mb-6 flex items-center">
        Freelance Work
        <span class="ml-3 px-2 py-0.5 rounded text-xs font-bold bg-accent/20 text-accent">NEW</span>
      </h4>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 animate-on-scroll animate-fade-up delay-200">
        {freelanceData.map((project, index) => (
          <div style={`animation-delay: ${(index * 100) + 200}ms`} class="animate-fade-up animate-on-scroll">
            <ProjectCard 
              title={project.title}
              description={project.description}
              tags={project.tags}
              link={project.link}
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
