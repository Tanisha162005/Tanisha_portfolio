---
import NodeGraph from './NodeGraph.astro';
---
<section class="relative min-h-[80vh] flex items-center justify-center pt-24 pb-16 lg:pt-0 mb-16 scroll-mt-24 text-center overflow-hidden" aria-label="Hero">
  <!-- Dynamic Background -->
  <div class="absolute inset-0 z-0 opacity-50">
    <NodeGraph />
  </div>
  
  <div class="relative z-10 max-w-3xl mx-auto px-4">
    <div class="inline-block mb-4 animate-fade-up">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-accent/10 text-accent border border-accent/20 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-accent mr-2 animate-pulse"></span>
        Available for Freelance
      </span>
    </div>

    <h2 class="text-4xl font-display font-bold tracking-tight text-text sm:text-5xl lg:text-[64px] leading-[1.1] mb-6 animate-fade-up delay-100">
      I build <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-purple-400">AI systems</span> that solve real problems.
    </h2>
    
    <p class="mt-4 max-w-2xl mx-auto text-[18px] leading-[1.6] text-text-muted mb-10 animate-fade-up delay-200">
      Motivated AI & ML undergraduate focused on NLP, agentic AI, and automation &mdash; from research prototypes to deployed products.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-up delay-300">
      <a href="#projects" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 bg-accent text-base font-medium text-black rounded-lg transition-all hover:bg-accent-dim hover:text-white focus:outline-none hover:shadow-[0_0_20px_rgba(59,130,246,0.5)] transform hover:-translate-y-1">
        View projects
      </a>
      <a href="#about" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 border border-glass-border bg-glass-bg backdrop-blur-sm text-text font-medium rounded-lg transition-all hover:bg-white/5 focus:outline-none transform hover:-translate-y-1">
        About me
      </a>
      <a href="/resume.pdf" target="_blank" class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 border border-glass-border bg-glass-bg backdrop-blur-sm text-text font-medium rounded-lg transition-all hover:bg-white/5 focus:outline-none transform hover:-translate-y-1">
        Resume
      </a>
    </div>
  </div>
</section>
