---
---
<section class="relative min-h-[90vh] flex items-center pt-24 pb-16 lg:pt-0 overflow-hidden" aria-label="Hero">
  <!-- Neural synapse canvas -->
  <canvas id="synapse-canvas" class="absolute inset-0 z-0" aria-hidden="true"></canvas>
  <!-- Gradient fade into base at bottom -->
  <div class="absolute inset-0 z-0 pointer-events-none" style="background: linear-gradient(to bottom, transparent 60%, var(--color-base) 100%);"></div>
  
  <div class="relative z-10 w-full max-w-3xl px-4">
    <div class="hero-stagger" style="opacity: 0;">
      <span class="inline-flex items-center px-3.5 py-1 rounded-full text-sm" style="border: 1px solid var(--color-border); background: var(--color-surface); color: var(--color-accent);">
        <span class="w-1.5 h-1.5 rounded-full mr-2 animate-pulse" style="background: var(--color-accent);"></span>
        Available for freelance
      </span>
    </div>

    <h1 class="hero-stagger mt-8 mb-8" style="opacity: 0;">
      I build <span style="color: var(--color-accent);">AI systems</span><br/>that solve real problems.
    </h1>
    
    <p class="hero-stagger max-w-2xl text-lg sm:text-xl mb-12" style="opacity: 0; line-height: 1.6; color: var(--color-text-muted);">
      Motivated AI &amp; ML undergraduate focused on NLP, agentic AI, and automation &mdash; from research prototypes to deployed products.
    </p>

    <div class="hero-stagger flex flex-col sm:flex-row items-start gap-4" style="opacity: 0;">
      <a href="#projects" class="hero-cta">View projects</a>
      <a href="#about" class="hero-cta">About me</a>
      <a href="/resume.pdf" target="_blank" class="hero-cta">Resume</a>
    </div>
  </div>
</section>

<style>
  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    transition: border-color 150ms ease, color 150ms ease;
    text-decoration: none;
  }
  .hero-cta:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    // Hero stagger entrance
    const staggerEls = document.querySelectorAll('.hero-stagger');
    gsap.fromTo(staggerEls, 
      { y: 25, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.9, stagger: 0.12, ease: "power3.out", delay: 0.15 }
    );

    // ── Synapse canvas ──
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canvas = document.getElementById('synapse-canvas') as HTMLCanvasElement;
    if (!canvas || prefersReducedMotion) {
      if (canvas) canvas.style.display = 'none';
      return;
    }

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width: number, height: number;
    let mouseX = -9999, mouseY = -9999;
    const PROXIMITY = 120;
    const CONNECTION_DIST = 160;

    interface Node {
      x: number; y: number;
      vx: number; vy: number;
      baseR: number;
      brightness: number; // 0–1, how "fired" this node is
    }

    const nodes: Node[] = [];

    const resize = () => {
      width = canvas.width = canvas.offsetWidth;
      height = canvas.height = canvas.offsetHeight;
    };

    window.addEventListener('resize', resize);
    resize();

    // Create nodes
    const isMobile = window.innerWidth < 768;
    const count = isMobile ? 30 : 70;
    for (let i = 0; i < count; i++) {
      nodes.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.25,
        vy: (Math.random() - 0.5) * 0.25,
        baseR: 1 + Math.random() * 1.5,
        brightness: 0
      });
    }

    // Track cursor (skip on mobile)
    if (!isMobile) {
      canvas.parentElement?.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouseX = e.clientX - rect.left;
        mouseY = e.clientY - rect.top;
      });
      canvas.parentElement?.addEventListener('mouseleave', () => {
        mouseX = -9999;
        mouseY = -9999;
      });
    }

    const accentRGB = { r: 140, g: 111, b: 247 }; // #8C6FF7
    const fireRGB  = { r: 255, g: 111, b: 145 };   // #FF6F91

    const animate = () => {
      ctx.clearRect(0, 0, width, height);

      // Update node positions & brightness
      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > width) n.vx *= -1;
        if (n.y < 0 || n.y > height) n.vy *= -1;

        // Check cursor proximity
        const dx = n.x - mouseX;
        const dy = n.y - mouseY;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < PROXIMITY) {
          n.brightness = Math.min(1, n.brightness + 0.08);
        } else {
          n.brightness = Math.max(0, n.brightness - 0.015);
        }
      }

      // Draw connections
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist > CONNECTION_DIST) continue;

          const closeness = 1 - dist / CONNECTION_DIST;
          const fire = Math.max(a.brightness, b.brightness);
          // Base opacity: very subtle. Fired: brighter.
          const baseAlpha = closeness * 0.06;
          const fireAlpha = closeness * fire * 0.35;
          const alpha = baseAlpha + fireAlpha;

          // Lerp color from accent to fire color based on fire level
          const r = Math.round(accentRGB.r + (fireRGB.r - accentRGB.r) * fire);
          const g = Math.round(accentRGB.g + (fireRGB.g - accentRGB.g) * fire);
          const bl = Math.round(accentRGB.b + (fireRGB.b - accentRGB.b) * fire);

          ctx.beginPath();
          ctx.strokeStyle = `rgba(${r},${g},${bl},${alpha})`;
          ctx.lineWidth = 0.8;
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }

      // Draw nodes
      for (const n of nodes) {
        const alpha = 0.12 + n.brightness * 0.5;
        const r = n.baseR + n.brightness * 1.5;
        const cr = Math.round(accentRGB.r + (fireRGB.r - accentRGB.r) * n.brightness);
        const cg = Math.round(accentRGB.g + (fireRGB.g - accentRGB.g) * n.brightness);
        const cb = Math.round(accentRGB.b + (fireRGB.b - accentRGB.b) * n.brightness);

        ctx.beginPath();
        ctx.fillStyle = `rgba(${cr},${cg},${cb},${alpha})`;
        ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
        ctx.fill();

        // Soft glow halo when fired
        if (n.brightness > 0.3) {
          ctx.beginPath();
          ctx.fillStyle = `rgba(${cr},${cg},${cb},${n.brightness * 0.08})`;
          ctx.arc(n.x, n.y, r + 6, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      requestAnimationFrame(animate);
    };

    animate();
  });
</script>
