---
---
<section class="relative min-h-[90vh] flex items-center justify-center pt-24 pb-16 lg:pt-0 overflow-hidden" aria-label="Hero">
  <!-- Dynamic Neural Ink Background -->
  <canvas id="neural-canvas" class="absolute inset-0 z-0 opacity-30"></canvas>
  <div class="absolute inset-0 z-0 bg-gradient-to-b from-transparent via-base/50 to-base pointer-events-none"></div>
  
  <div class="relative z-10 max-w-4xl mx-auto px-4 w-full">
    <div class="hero-stagger opacity-0 invisible inline-block mb-6">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-medium border border-glass-border bg-glass-bg backdrop-blur-sm text-accent-pop">
        <span class="w-2 h-2 rounded-full bg-accent-pop mr-2 animate-pulse"></span>
        Available for Freelance
      </span>
    </div>

    <h2 class="hero-stagger opacity-0 invisible text-5xl font-display font-bold tracking-tight text-text sm:text-6xl lg:text-[72px] leading-[1.05] mb-8">
      I build <span class="text-gradient">AI systems</span><br/>that solve real problems.
    </h2>
    
    <p class="hero-stagger opacity-0 invisible mt-4 max-w-2xl text-lg sm:text-xl leading-[1.7] text-text-muted mb-12">
      Motivated AI & ML undergraduate focused on NLP, agentic AI, and automation &mdash; from research prototypes to deployed products.
    </p>

    <div class="hero-stagger opacity-0 invisible flex flex-col sm:flex-row items-center gap-6">
      <a href="#projects" class="magnetic-btn group relative inline-flex items-center justify-center px-8 py-4 bg-transparent text-base font-medium text-text rounded-xl overflow-hidden focus:outline-none transition-colors hover:text-white border border-glass-border bg-glass-bg backdrop-blur-md">
        <span class="relative z-10 inline-block">View projects</span>
        <div class="absolute inset-0 border-gradient-glow opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl"></div>
      </a>
      <a href="#about" class="magnetic-btn group relative inline-flex items-center justify-center px-8 py-4 bg-transparent text-base font-medium text-text rounded-xl overflow-hidden focus:outline-none transition-colors hover:text-white border border-glass-border bg-glass-bg backdrop-blur-md">
        <span class="relative z-10 inline-block">About me</span>
        <div class="absolute inset-0 border-gradient-glow opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl"></div>
      </a>
      <a href="/resume.pdf" target="_blank" class="magnetic-btn group relative inline-flex items-center justify-center px-8 py-4 bg-transparent text-base font-medium text-text rounded-xl overflow-hidden focus:outline-none transition-colors hover:text-white border border-glass-border bg-glass-bg backdrop-blur-md">
        <span class="relative z-10 inline-block">Resume</span>
        <div class="absolute inset-0 border-gradient-glow opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-xl"></div>
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  // Magnetic Button Logic
  const magneticBtns = document.querySelectorAll('.magnetic-btn');
  
  magneticBtns.forEach((btn) => {
    btn.addEventListener('mousemove', (e: any) => {
      const position = btn.getBoundingClientRect();
      const x = e.clientX - position.left - position.width / 2;
      const y = e.clientY - position.top - position.height / 2;
      
      gsap.to(btn, {
        x: x * 0.2,
        y: y * 0.2,
        duration: 0.6,
        ease: "power3.out"
      });
      
      const text = btn.querySelector('span');
      if (text) {
        gsap.to(text, {
          x: x * 0.1,
          y: y * 0.1,
          duration: 0.6,
          ease: "power3.out"
        });
      }
    });

    btn.addEventListener('mouseleave', () => {
      gsap.to(btn, {
        x: 0,
        y: 0,
        duration: 0.6,
        ease: "elastic.out(1, 0.3)"
      });
      
      const text = btn.querySelector('span');
      if (text) {
        gsap.to(text, {
          x: 0,
          y: 0,
          duration: 0.6,
          ease: "elastic.out(1, 0.3)"
        });
      }
    });
  });

  // Hero Stagger Animation
  document.addEventListener('DOMContentLoaded', () => {
    const staggerEls = document.querySelectorAll('.hero-stagger');
    
    gsap.fromTo(staggerEls, 
      { y: 30, autoAlpha: 0 },
      { 
        y: 0, 
        autoAlpha: 1, 
        duration: 1.2, 
        stagger: 0.15,
        ease: "power3.out",
        delay: 0.1
      }
    );

    // Neural Canvas Background
    const canvas = document.getElementById('neural-canvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width, height;
    const particles: {x: number, y: number, vx: number, vy: number}[] = [];
    const connectionDistance = 150;

    const resize = () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    };
    
    window.addEventListener('resize', resize);
    resize();

    const numParticles = window.innerWidth < 768 ? 40 : 80;
    for (let i = 0; i < numParticles; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4
      });
    }

    const animate = () => {
      ctx.clearRect(0, 0, width, height);
      
      ctx.fillStyle = '#8B93A7'; // Muted text color for subtle dots
      ctx.lineWidth = 0.5;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0 || p.x > width) p.vx *= -1;
        if (p.y < 0 || p.y > height) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.2, 0, Math.PI * 2);
        ctx.fill();

        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p.x - p2.x;
          const dy = p.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < connectionDistance) {
            ctx.beginPath();
            ctx.strokeStyle = `rgba(139, 147, 167, ${(1 - dist / connectionDistance) * 0.3})`;
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(animate);
    };
    animate();
  });
</script>
