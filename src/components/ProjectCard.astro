---
interface Props {
  title: string;
  description: string;
  tags: string[];
  link: string;
  large?: boolean;
}

const { title, description, tags, link, large = false } = Astro.props;
---
<a href={link} target="_blank" rel="noreferrer" class={`project-card card group flex flex-col items-start gap-3 p-6 block ${large ? 'md:col-span-2 md:p-8' : ''}`}>
  
  <div class="w-full flex flex-col h-full">
    <div class="flex justify-between items-start w-full">
      <h3 class={`transition-colors duration-150 ${large ? 'text-xl lg:text-2xl' : ''}`} style="color: var(--color-text);">
        {title}
      </h3>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 shrink-0 ml-3 mt-0.5 transition-colors duration-150" style="color: var(--color-text-muted);" aria-hidden="true"><path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd"></path></svg>
    </div>
    
    <p class={`mt-3 ${large ? 'text-base max-w-3xl' : 'text-sm'}`} style="line-height: 1.6;">
      {description}
    </p>
    
    <div class="mt-auto pt-6 w-full">
      <ul class="flex flex-wrap gap-2" aria-label="Technologies used">
        {tags.map(tag => (
          <li class="pill" style="font-size: 0.75rem;">{tag}</li>
        ))}
      </ul>
    </div>
  </div>
</a>

<style>
  .project-card h3 {
    color: var(--color-text);
  }
  .project-card:hover h3 {
    color: var(--color-accent);
  }
  .project-card:hover svg {
    color: var(--color-accent);
  }
</style>
