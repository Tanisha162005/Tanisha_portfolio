---
interface Props {
  title: string;
  description: string;
  tags: string[];
  link: string;
  large?: boolean;
}

const { title, description, tags, link, large = false } = Astro.props;
---
<a href={link} target="_blank" rel="noreferrer" class={`project-card group relative flex flex-col items-start gap-4 p-8 glass-panel overflow-hidden border-gradient-glow block hover:glow-shadow ${large ? 'md:col-span-2 md:p-12' : ''}`}>
  
  <div class="relative z-10 w-full flex flex-col h-full project-content">
    <div class="flex justify-between items-start w-full">
      <h3 class={`font-display font-bold text-text group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-[#7C3AED] group-hover:to-[#22D3EE] transition-all duration-300 ${large ? 'text-3xl lg:text-4xl' : 'text-2xl'}`}>
        {title}
      </h3>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-6 h-6 text-text-muted group-hover:text-text transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 shrink-0 ml-4"><path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 001.06 0l7.22-7.22v5.69a.75.75 0 001.5 0v-7.5a.75.75 0 00-.75-.75h-7.5a.75.75 0 000 1.5h5.69l-7.22 7.22a.75.75 0 000 1.06z" clip-rule="evenodd"></path></svg>
    </div>
    
    <p class={`mt-4 leading-relaxed text-text-muted ${large ? 'text-lg max-w-3xl' : 'text-base'}`}>
      {description}
    </p>
    
    <div class="mt-auto pt-8 w-full">
      <ul class="flex flex-wrap gap-2 project-tags" aria-label="Technologies used">
        {tags.map(tag => (
          <li class="rounded-md bg-surface-hi px-3 py-1.5 text-xs font-medium text-text-muted border border-glass-border transition-colors group-hover:border-[#7C3AED]/40 group-hover:text-text">
            {tag}
          </li>
        ))}
      </ul>
    </div>
  </div>
</a>
